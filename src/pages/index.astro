---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icons.astro";

const productSignals = [
  {
    title: "Retained Kubernetes evidence",
    text: "Store sanitized versions, facts, edges, and observations.",
    icon: "archive",
    tone: "accent",
  },
  {
    title: "Human and agent query surfaces",
    text: "Use read-only SQL, API, and MCP before live checks.",
    icon: "database-zap",
    tone: "signal",
  },
  {
    title: "Sanitized by design",
    text: "Filter sensitive fields before evidence is stored.",
    icon: "shield-check",
    tone: "warn",
  },
] as const;

const buildItems = [
  {
    title: "Infrastructure evidence",
    text: "Retain operational history and make past system state easier to query and verify.",
    icon: "database-zap",
    tone: "accent",
  },
  {
    title: "Kubernetes-native automation",
    text: "Reduce repeated infrastructure work while preserving Kubernetes patterns.",
    icon: "workflow",
    tone: "signal",
  },
  {
    title: "Access and auditability",
    text: "Make temporary access, operation records, and production changes easier to explain.",
    icon: "key-round",
    tone: "warn",
  },
  {
    title: "Alert intelligence",
    text: "Reduce notification noise and surface cases that deserve attention with history and feedback.",
    icon: "filter",
    tone: "accent",
  },
] as const;

const principles = [
  "Open source first",
  "Evidence before automation",
  "Operator control before autonomy",
  "Least privilege before convenience",
  "Auditability before magic",
  "Boring reliability over AI spectacle",
];
---

<BaseLayout>
  <section id="top" class="hero grid-paper">
    <div class="page-shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Open-source cloud-native operations</p>
        <h1>Help engineers focus on what matters.</h1>
        <p class="hero-subtitle">
          nowake.ai builds open-source, AI-assisted tools that make infrastructure work easier to inspect, automate, and prioritize.
        </p>
        <div class="hero-actions">
          <a class="button button-primary spotlight-button" href="/projects/kube-insight">
            <Icon name="database-zap" class="icon-sm" />
            Explore kube-insight
          </a>
          <a class="button button-secondary" href="/docs/kube-insight/">
            <Icon name="book-open" class="icon-sm" />
            Read docs
          </a>
        </div>
      </div>

      <div class="hero-product-wrap">
        <article class="surface hero-product" aria-label="kube-insight product introduction">
          <div class="product-kicker">
            <span>flagship product</span>
            <span class="badge accent-badge">kubernetes aiops</span>
          </div>
          <h2>kube-insight</h2>
          <p class="product-tagline">The missing history layer for Kubernetes AIOps.</p>
          <p class="product-copy">
            Preserve sanitized Kubernetes history so humans and agents can investigate from retained proof before checking live state.
          </p>
          <div class="product-signal-list">
            {
              productSignals.map((item) => (
                <div class="product-signal">
                  <Icon name={item.icon} class={["icon", item.tone].join(" ")} />
                  <div>
                    <strong>{item.title}</strong>
                    <span>{item.text}</span>
                  </div>
                </div>
              ))
            }
          </div>
          <div class="product-actions">
            <a class="button button-primary" href="/projects/kube-insight">
              <Icon name="arrow-up-right" class="icon-sm" />
              Open product page
            </a>
            <a class="text-link" href="/docs/kube-insight/getting-started/">
              Quickstart
              <Icon name="arrow-up-right" class="icon-sm" />
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>
  <section id="build" class="section">
    <div class="page-shell">
      <div class="section-intro">
        <p class="section-label">What we build</p>
        <h2>Tools for evidence, automation, access, and signal.</h2>
        <p>
          AI is part of the route, but not the product promise. The shared goal is practical infrastructure work that
          engineers can inspect, trust, and control.
        </p>
      </div>
      <div class="four-grid">
        {
          buildItems.map((item) => (
            <article class="surface feature-card">
              <Icon name={item.icon} class={["icon", item.tone].join(" ")} />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="projects" class="section white-section">
    <div class="page-shell">
      <div class="section-head-row">
        <div>
          <p class="section-label">Active projects</p>
          <h2>Current work</h2>
        </div>
        <a class="text-link" href="https://github.com/nowakeai">
          Open GitHub
          <Icon name="arrow-up-right" class="icon-sm" />
        </a>
      </div>

      <div class="project-grid">
        <article class="surface project-card project-card-featured">
          <div class="project-meta">
            <p>Active / flagship</p>
            <span class="badge accent-badge">kubernetes</span>
          </div>
          <h3>kube-insight</h3>
          <p>
            Retained Kubernetes evidence for humans and agents: sanitized list/watch history, facts, topology, and read-only SQL, API, and MCP surfaces.
          </p>
          <div class="card-actions">
            <a class="button button-primary" href="/projects/kube-insight">Project page</a>
            <a class="button button-secondary" href="/docs/kube-insight/">Docs</a>
            <a class="button button-secondary" href="https://github.com/nowakeai/kube-insight">GitHub</a>
          </div>
        </article>

        <article class="surface project-card">
          <div class="project-meta">
            <p>Active</p>
            <span class="badge signal-badge">controller</span>
          </div>
          <h3>svc-lb-mux</h3>
          <p>
            Service LoadBalancer Multiplexer: a Kubernetes controller that lets many application-facing LoadBalancer
            Services share one provider-managed Layer 4 load balancer.
          </p>
          <div class="card-actions">
            <a class="button button-primary" href="/projects/svc-lb-mux">Project page</a>
            <a class="button button-secondary" href="/docs/svc-lb-mux/">Docs</a>
            <a class="button button-secondary" href="https://github.com/nowakeai/svc-lb-mux">GitHub</a>
          </div>
        </article>

        <article class="surface project-card">
          <div class="project-meta">
            <p>Active / alpha</p>
            <span class="badge warn-badge">egress</span>
          </div>
          <h3>BetterNAT</h3>
          <p>
            Self-owned, observable NAT for AWS private subnet workloads where managed NAT Gateway processing fees become
            a visible cost problem.
          </p>
          <div class="card-actions">
            <a class="button button-primary" href="/projects/betternat">Project page</a>
            <a class="button button-secondary" href="/docs/betternat/">Docs</a>
            <a class="button button-secondary" href="https://github.com/nowakeai/betternat">GitHub</a>
          </div>
        </article>
      </div>
    </div>
  </section>
  <section id="principles" class="section">
    <div class="page-shell split-section principles-section">
      <div>
        <p class="section-label">Principles</p>
        <h2>No magic in the control plane.</h2>
      </div>
      <div class="principle-grid">
        {principles.map((item) => <div>{item}</div>)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--color-border);
  }

  .hero-grid {
    min-height: calc(100vh - 145px);
    display: grid;
    gap: 2.5rem;
    padding-block: 3rem;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero h1 {
    max-width: 52rem;
    margin: 1.25rem 0 0;
    font-size: 2.25rem;
    line-height: 1.08;
    font-weight: 650;
    letter-spacing: 0;
  }

  .hero-subtitle {
    max-width: 47rem;
    margin: 1.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .hero-actions,
  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .spotlight-button {
    min-height: 48px;
    padding-inline: 1.15rem;
    box-shadow: 0 14px 34px rgba(23, 31, 48, 0.18);
  }

  .hero-product-wrap {
    display: flex;
    align-items: center;
  }

  .hero-product {
    width: 100%;
    border-radius: var(--radius-md);
    padding: 1.1rem;
  }

  .product-kicker,
  .project-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .product-kicker span:first-child,
  .project-meta p {
    margin: 0;
    color: var(--color-accent);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 650;
    text-transform: uppercase;
  }

  .hero-product h2 {
    margin: 1.15rem 0 0;
    font-size: clamp(2.4rem, 5vw, 4.35rem);
    line-height: 0.95;
    font-weight: 650;
  }

  .product-tagline {
    margin: 0.8rem 0 0;
    color: var(--color-accent);
    font-size: clamp(1.2rem, 2vw, 1.55rem);
    line-height: 1.15;
    font-weight: 650;
  }

  .product-copy {
    margin: 0.85rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .product-signal-list {
    display: grid;
    gap: 0.55rem;
    margin-top: 1rem;
  }

  .product-signal {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.7rem;
    align-items: start;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-page);
    padding: 0.7rem;
  }

  .product-signal strong {
    display: block;
    font-size: 0.9rem;
  }

  .product-signal span {
    display: block;
    margin-top: 0.2rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
    line-height: 1.35;
  }

  .product-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1rem;
  }

  .section {
    border-top: 1px solid var(--color-border);
    padding-block: 4rem;
  }

  .white-section {
    background: var(--color-surface);
  }

  .split-section {
    display: grid;
    gap: 2rem;
  }

  .section-label {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 650;
  }

  .section h2,
  .section-intro h2,
  .section-head-row h2 {
    margin: 0.75rem 0 0;
    font-size: 1.875rem;
    line-height: 1.2;
    font-weight: 650;
    letter-spacing: 0;
  }

  .section-intro {
    max-width: 48rem;
  }

  .section-intro p:last-child {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .four-grid,
  .project-grid,
  .principle-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }

  .feature-card,
  .project-card {
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .project-card-featured {
    border-color: rgba(36, 90, 174, 0.28);
    box-shadow: 0 20px 52px rgba(36, 90, 174, 0.12);
  }

  .feature-card h3,
  .project-card h3 {
    margin: 1rem 0 0;
    font-size: 1rem;
    font-weight: 650;
  }

  .project-card h3 {
    font-size: 1.5rem;
  }

  .feature-card p,
  .project-card > p {
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .section-head-row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .text-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 650;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 650;
  }

  .accent-badge {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .signal-badge {
    background: var(--color-signal-soft);
    color: var(--color-signal);
  }

  .warn-badge {
    background: var(--color-warn-soft);
    color: var(--color-warn);
  }

  .principles-section .principle-grid {
    margin-top: 0;
  }

  .principle-grid div {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-page);
    padding: 1rem;
    font-size: 0.875rem;
    font-weight: 650;
  }

  @media (max-width: 639px) {
    .hero-grid {
      gap: 1.5rem;
      padding-block: 2rem;
    }

    .hero-subtitle {
      margin-top: 1rem;
      line-height: 1.55;
    }

    .hero-actions {
      margin-top: 1.4rem;
    }

    .hero-product h2 {
      margin-top: 0.9rem;
    }

    .product-copy,
    .product-signal-list {
      display: none;
    }
  }

  @media (min-width: 640px) {
    .hero h1 {
      font-size: 3rem;
    }

    .principle-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 768px) {
    .section-head-row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .four-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.92fr) minmax(28rem, 0.92fr);
      padding-block: 3.5rem;
    }

    .hero h1 {
      font-size: 3.65rem;
    }

    .split-section {
      grid-template-columns: 0.78fr 1.22fr;
    }

    .four-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .principle-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
