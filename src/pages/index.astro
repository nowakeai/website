---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icons.astro";

const noiseRows = [
  {
    title: "Alerts and notification noise",
    text: "Triage should preserve context and lift meaningful cases.",
    icon: "bell-ring",
    tone: "accent",
  },
  {
    title: "Manual maintenance",
    text: "Repeated work should become bounded, reviewable automation.",
    icon: "wrench",
    tone: "signal",
  },
  {
    title: "Access, safety, and audit",
    text: "Production changes need least privilege and accountable records.",
    icon: "shield-check",
    tone: "warn",
  },
  {
    title: "Recovery and capacity work",
    text: "Known procedures should be easier to verify and repeat.",
    icon: "activity",
    tone: "accent",
  },
] as const;

const buildItems = [
  {
    title: "Infrastructure evidence",
    text: "Retain operational history and make past system state easier to query and verify.",
    icon: "database-zap",
    tone: "accent",
  },
  {
    title: "Kubernetes-native automation",
    text: "Reduce repeated infrastructure work while preserving Kubernetes patterns.",
    icon: "workflow",
    tone: "signal",
  },
  {
    title: "Access and auditability",
    text: "Make temporary access, operation records, and production changes easier to explain.",
    icon: "key-round",
    tone: "warn",
  },
  {
    title: "Alert intelligence",
    text: "Reduce notification noise and surface cases that deserve attention with history and feedback.",
    icon: "filter",
    tone: "accent",
  },
] as const;

const principles = [
  "Open source first",
  "Evidence before automation",
  "Operator control before autonomy",
  "Least privilege before convenience",
  "Auditability before magic",
  "Boring reliability over AI spectacle",
];
---

<BaseLayout>
  <section id="top" class="hero grid-paper">
    <div class="page-shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Open-source cloud-native operations</p>
        <h1>Less operational noise. More important work.</h1>
        <p class="hero-subtitle">
          nowake.ai builds open-source, AI-assisted tools that make infrastructure work easier to inspect, automate, and prioritize.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="#build">
            <Icon name="arrow-down" class="icon-sm" />
            What we build
          </a>
          <a class="button button-secondary" href="/projects/kube-insight">
            <Icon name="box" class="icon-sm" />
            Explore kube-insight
          </a>
        </div>
      </div>

      <div class="hero-panel-wrap">
        <div class="surface hero-panel">
          <div class="panel-header">
            <span>operational-noise.index</span>
            <span class="badge accent-badge">inspectable</span>
          </div>
          <div class="noise-list">
            {
              noiseRows.map((item) => (
                <div class="noise-row">
                  <div>
                    <p>{item.title}</p>
                    <span>{item.text}</span>
                  </div>
                  <Icon name={item.icon} class={`icon ${item.tone}`} />
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
  <section id="build" class="section">
    <div class="page-shell">
      <div class="section-intro">
        <p class="section-label">What we build</p>
        <h2>Tools for evidence, automation, access, and signal.</h2>
        <p>
          AI is part of the route, but not the product promise. The shared goal is practical infrastructure work that
          engineers can inspect, trust, and control.
        </p>
      </div>
      <div class="four-grid">
        {
          buildItems.map((item) => (
            <article class="surface feature-card">
              <Icon name={item.icon} class={`icon ${item.tone}`} />
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="projects" class="section white-section">
    <div class="page-shell">
      <div class="section-head-row">
        <div>
          <p class="section-label">Active projects</p>
          <h2>Current work</h2>
        </div>
        <a class="text-link" href="https://github.com/nowakeai">
          Open GitHub
          <Icon name="arrow-up-right" class="icon-sm" />
        </a>
      </div>

      <div class="project-grid">
        <article class="surface project-card">
          <div class="project-meta">
            <p>Active / flagship</p>
            <span class="badge accent-badge">kubernetes</span>
          </div>
          <h3>kube-insight</h3>
          <p>
            Retained Kubernetes evidence for humans and agents: sanitized list/watch history, facts, topology, and read-only SQL, API, and MCP surfaces.
          </p>
          <div class="card-actions">
            <a class="button button-primary" href="/projects/kube-insight">Project page</a>
            <a class="button button-secondary" href="https://github.com/nowakeai/kube-insight">GitHub</a>
          </div>
        </article>

        <article class="surface project-card">
          <div class="project-meta">
            <p>Active</p>
            <span class="badge signal-badge">controller</span>
          </div>
          <h3>svc-lb-mux</h3>
          <p>
            Service LoadBalancer Multiplexer: a Kubernetes controller that lets many application-facing LoadBalancer
            Services share one provider-managed Layer 4 load balancer.
          </p>
          <div class="card-actions">
            <a class="button button-primary" href="/projects/svc-lb-mux">Project page</a>
            <a class="button button-secondary" href="https://github.com/nowakeai/svc-lb-mux">GitHub</a>
          </div>
        </article>
      </div>
    </div>
  </section>
  <section id="principles" class="section">
    <div class="page-shell split-section principles-section">
      <div>
        <p class="section-label">Principles</p>
        <h2>No magic in the control plane.</h2>
      </div>
      <div class="principle-grid">
        {principles.map((item) => <div>{item}</div>)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--color-border);
  }

  .hero-grid {
    min-height: calc(100vh - 73px);
    display: grid;
    gap: 2.5rem;
    padding-block: 3.5rem;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero h1 {
    max-width: 64rem;
    margin: 1.25rem 0 0;
    font-size: 2.25rem;
    line-height: 1.05;
    font-weight: 650;
    letter-spacing: 0;
  }

  .hero-subtitle {
    max-width: 48rem;
    margin: 1.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.75;
  }

  .hero-actions,
  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-panel-wrap {
    display: flex;
    align-items: center;
  }

  .hero-panel {
    width: 100%;
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1rem;
    color: var(--color-text-muted);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 650;
    text-transform: uppercase;
  }

  .noise-list {
    margin-top: 1.25rem;
  }

  .noise-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
    padding: 0.875rem 0;
  }

  .noise-row:last-child {
    border-bottom: 0;
  }

  .noise-row p {
    margin: 0;
    font-weight: 650;
  }

  .noise-row span {
    display: block;
    margin-top: 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .section {
    border-top: 1px solid var(--color-border);
    padding-block: 4rem;
  }

  .white-section {
    background: var(--color-surface);
  }

  .split-section {
    display: grid;
    gap: 2rem;
  }

  .section-label {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 650;
  }

  .section h2,
  .section-intro h2,
  .section-head-row h2 {
    margin: 0.75rem 0 0;
    font-size: 1.875rem;
    line-height: 1.2;
    font-weight: 650;
    letter-spacing: 0;
  }

  .section-intro {
    max-width: 48rem;
  }

  .section-intro p:last-child {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .four-grid,
  .project-grid,
  .principle-grid {
    display: grid;
    gap: 1rem;
  }

  .four-grid,
  .project-grid,
  .principle-grid {
    margin-top: 2rem;
  }

  .feature-card,
  .project-card {
    border-radius: var(--radius-md);
    padding: 1.25rem;
  }

  .feature-card h3,
  .project-card h3 {
    margin: 1rem 0 0;
    font-size: 1rem;
    font-weight: 650;
  }

  .project-card h3 {
    font-size: 1.5rem;
  }

  .feature-card p,
  .project-card > p {
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .section-head-row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .text-link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 650;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-sm);
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-weight: 650;
  }

  .accent-badge {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .signal-badge {
    background: var(--color-signal-soft);
    color: var(--color-signal);
  }

  .project-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-meta p {
    margin: 0;
    color: var(--color-accent);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.75rem;
    font-weight: 650;
    text-transform: uppercase;
  }

  .principles-section .principle-grid {
    margin-top: 0;
  }

  .principle-grid div {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-page);
    padding: 1rem;
    font-size: 0.875rem;
    font-weight: 650;
  }

  @media (min-width: 640px) {
    .hero h1 {
      font-size: 3rem;
    }

    .principle-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 768px) {
    .section-head-row {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .four-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.06fr 0.94fr;
      padding-block: 5rem;
    }

    .hero h1 {
      font-size: 3.75rem;
    }

    .split-section {
      grid-template-columns: 0.78fr 1.22fr;
    }

    .four-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .principle-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
