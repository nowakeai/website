---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icons.astro";
import KubeInsightFlow from "../../components/project/KubeInsightFlow.astro";
import KubeInsightPerformance from "../../components/project/KubeInsightPerformance.astro";
import KubeInsightUseCases from "../../components/project/KubeInsightUseCases.astro";
import StorageLogo from "../../components/project/StorageLogo.astro";

const modes = [
  { name: "SQLite", logo: "sqlite", role: "default local", stat: "smallest start", text: "A pure-Go default artifact with one local evidence database for first captures, laptops, CI fixtures, and local agent workflows." },
  { name: "chDB", logo: "chdb", role: "local ClickHouse shape", stat: "embedded analytics", text: "A chDB-enabled artifact when you want ClickHouse-compatible local tables without operating a ClickHouse server." },
  { name: "ClickHouse", logo: "clickhouse", role: "central history", stat: "team service", text: "A continuous evidence service for append-heavy history, compression, API/MCP reads, and future cold-tiering work." },
] as const;

const heroStats = [
  { value: "24-215 ms", label: "five retained-evidence agent workflow queries" },
  { value: "14.9x-221x", label: "faster than comparable broad kubectl paths" },
  { value: "auto-redaction", label: "configurable filters and extractors keep sensitive data out of evidence" },
] as const;

const releaseHighlights = [
  { label: "A2A", text: "Agent-to-agent integration surface for teams connecting kube-insight into agent workflows." },
  { label: "kagent", text: "Dedicated kagent chart support for running kube-insight with Kubernetes-native agent automation." },
  { label: "Helm", text: "Published chart path plus image defaults tied to the released container tag." },
  { label: "Web UI", text: "Release binaries still ship the embedded React app for serve --app demos and local investigations." },
] as const;

const installCommand = [
  "KI_VERSION=\"$(curl -fsSL https://api.github.com/repos/nowakeai/kube-insight/releases/latest | sed -n 's/.*\"tag_name\": \"v\\([^\"]*\\)\".*/\\1/p')\"",
  "test -n \"${KI_VERSION}\"",
  "KI_OS=\"$(uname -s | tr '[:upper:]' '[:lower:]')\"",
  "KI_ARCH=\"$(uname -m)\"",
  "case \"${KI_ARCH}\" in",
  "  x86_64) KI_ARCH=amd64 ;;",
  "  aarch64) KI_ARCH=arm64 ;;",
  "esac",
  "",
  "curl -L -o kube-insight.tar.gz \\",
  "  \"https://github.com/nowakeai/kube-insight/releases/download/v${KI_VERSION}/kube-insight_${KI_VERSION}_${KI_OS}_${KI_ARCH}.tar.gz\"",
  "tar -xzf kube-insight.tar.gz kube-insight",
  "chmod +x kube-insight"
].join("\n");

const serviceCommand = [
  "./kube-insight serve --watch --app \\",
  "  --db kubeinsight.db \\",
  "  --listen 127.0.0.1:8090"
].join("\n");

const apiSmokeCommand = [
  "curl http://127.0.0.1:8090/healthz",
  "curl http://127.0.0.1:8090/api/v1/schema",
  "curl 'http://127.0.0.1:8090/api/v1/health?errorsOnly=true&problemLimit=20'"
].join("\n");

const demoVideoUrl = "https://github.com/user-attachments/assets/abc0dd70-9237-4fd8-b17e-235336bee1f0";

const mcpAgentConfig = [
  "{",
  "  \"mcpServers\": {",
  "    \"kube-insight\": {",
  "      \"type\": \"streamable-http\",",
  "      \"url\": \"http://127.0.0.1:8090/mcp\"",
  "    }",
  "  }",
  "}",
  "",
  "# First investigation loop:",
  "kube_insight_schema -> kube_insight_health -> kube_insight_sql -> kube_insight_history"
].join("\n");

const productCards = [
  { icon: "archive", title: "Keep the state that disappeared", text: "Events expire, Pods restart, EndpointSlices change, and deleted objects vanish from the apiserver. kube-insight keeps observed versions and timestamps so the old state can still be inspected." },
  { icon: "workflow", title: "Turn raw history into queryable clues", text: "Extracted facts, changes, and topology edges let operators and agents rank candidate Services, Pods, Events, owners, RBAC, webhooks, and policies before opening full JSON proof." },
  { icon: "shield-check", title: "Reduce the agent blast radius", text: "Configurable filters and extractors redact sensitive data before storage. Future service mode will inherit Kubernetes RBAC so agents see only what they are allowed to inspect." },
] as const;

const docsHighlights = [
  { label: "Run the embedded agent", title: "Built-in Web UI Agent", text: "Configure server-side LLM credentials, start serve --app, and investigate retained proof in the browser.", href: "/docs/kube-insight/guides/builtin-webui-agent/" },
  { label: "Bring your own agent", title: "External Agent Skill", text: "Connect Codex, Claude, or another MCP-capable runtime to kube-insight as a retained-evidence service.", href: "/docs/kube-insight/guides/external-agent-skill/" },
  { label: "Operational cases", title: "Real-World Cases", text: "Webhook, Event, Service, EndpointSlice, RBAC, cert-manager, Flux, and Node-capacity investigations grounded in retained evidence.", href: "/docs/kube-insight/guides/real-world-cases/" },
  { label: "Operate it", title: "Configuration And Processing", text: "Validate config, inspect effective defaults, tune resource profiles, and understand filters, extractors, and retention behavior.", href: "/docs/kube-insight/operations/configuration/" },
  { label: "Evidence vocabulary", title: "Facts Catalog", text: "Use extracted fact families as fast candidate paths before opening retained JSON versions as proof.", href: "/docs/kube-insight/concepts/facts-catalog/" },
  { label: "Security roadmap", title: "RBAC-Aware Evidence", text: "Track the design for Kubernetes RBAC inheritance and authorization-aware SQL over derived evidence.", href: "/docs/kube-insight/security/kubernetes-rbac-inheritance/" },
] as const;
---

<BaseLayout
  title="kube-insight | nowake.ai"
  description="kube-insight captures sanitized Kubernetes history and exposes retained evidence through read-only SQL, API, and MCP surfaces."
  githubHref="https://github.com/nowakeai/kube-insight"
  githubLabel="kube-insight"
>
  <section class="ki-product-hero grid-paper">
    <div class="page-shell hero-layout">
      <div class="hero-copy">
        <p class="eyebrow">Active / flagship</p>
        <h1>kube-insight</h1>
        <p class="hero-tagline">The missing history layer for Kubernetes AIOps.</p>
        <p class="hero-description">
          Logs have search systems. Metrics have time-series stores. Traces preserve application flows. Kubernetes
          infrastructure state is still too often reduced to <strong>whatever the apiserver shows right now</strong>. kube-insight turns that
          gap into an AIOps foundation: it records Kubernetes resource history at <strong>low operational cost</strong>, extracts facts and
          topology, and exposes <strong>human- and agent-friendly query surfaces</strong>. Agents can work from <strong>retained evidence</strong> first,
          then use live <code>kubectl</code> only for final confirmation instead of rebuilding context from scratch.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="https://github.com/nowakeai/kube-insight">
            <Icon name="github" class="icon-sm" />
            GitHub
          </a>
          <a class="button button-secondary" href="/docs/kube-insight/">
            <Icon name="book-open" class="icon-sm" />
            Docs
          </a>
          <a class="button button-secondary" href="#agent-demo">
            <Icon name="activity" class="icon-sm" />
            Watch demo
          </a>
        </div>
      </div>

      <aside class="hero-console" aria-label="kube-insight product highlights">
        <div class="console-header">
          <span>agent.workflow</span>
          <span>retained proof</span>
        </div>
        <div class="agent-sequence" aria-label="Agent investigation sequence">
          <div class="participants" aria-hidden="true">
            <span>Agent</span>
            <span>MCP</span>
            <span>Evidence DB</span>
            <span>K8s API</span>
          </div>
          <div class="sequence-row agent-to-mcp">
            <span>kube_insight_schema</span>
          </div>
          <div class="sequence-row mcp-to-db">
            <span>backend notes, tables, recipes</span>
          </div>
          <div class="sequence-row db-to-agent">
            <span>schema + SQL recipes</span>
          </div>
          <div class="sequence-row agent-to-db">
            <span>coverage, facts, edges</span>
          </div>
          <div class="sequence-row db-to-agent proof-row">
            <span>ranked candidates + proof bundle</span>
          </div>
          <div class="sequence-row agent-to-kube optional-row">
            <span>optional kubectl comparison</span>
          </div>
        </div>
      </aside>
    </div>
  </section>


  <section class="metrics-band" aria-label="kube-insight core selling points">
    <div class="page-shell metrics-grid">
      {heroStats.map((item) => <article><strong>{item.value}</strong><span>{item.label}</span></article>)}
    </div>
  </section>

  <section class="release-strip" aria-label="kube-insight latest release">
    <div class="page-shell release-layout">
      <div class="release-summary">
        <p class="section-label">Latest release</p>
        <h2>v0.1.3 adds A2A, kagent, and Helm integration.</h2>
        <p>
          Published on July 1, 2026, this release ships default Linux, macOS, and Windows archives,
          chDB-enabled archives, a matching container image, and the embedded Web UI.
        </p>
        <a class="text-link" href="https://github.com/nowakeai/kube-insight/releases/tag/v0.1.3">
          Release notes
        </a>
      </div>
      <div class="release-grid">
        {releaseHighlights.map((item) => (
          <article>
            <strong>{item.label}</strong>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>


  <section id="agent-demo" class="section demo-section">
    <div class="page-shell demo-layout">
      <div class="section-intro">
        <p class="section-label">Built-in agent demo</p>
        <h2>Ask about a node-pool change and get retained proof back.</h2>
        <p>
          The demo asks the embedded kube-insight agent whether a managed Kubernetes node pool changed recently. The answer uses retained Node lifecycle history, SQL aggregation, current node capacity, and citations instead of broad live cluster browsing.
        </p>
      </div>
      <div class="demo-player" aria-label="kube-insight built-in agent demo video">
        <video class="demo-video" controls preload="metadata" playsinline>
          <source src={demoVideoUrl} type="video/mp4" />
          <a href={demoVideoUrl}>Open the kube-insight built-in agent demo video</a>
        </video>
        <div class="demo-video-caption">
          <span>Built-in Web UI agent answering from retained Node history, SQL aggregation, and citations.</span>
          <a href={demoVideoUrl}>
            <Icon name="arrow-up-right" class="icon-sm" />
            Open original
          </a>
        </div>
      </div>
    </div>
  </section>


  <section class="section quickstart-section">
    <div class="page-shell quickstart-layout">
      <div class="section-intro quickstart-intro">
        <p class="section-label">Quickstart</p>
        <h2>Run the collector, Web UI, API, and MCP surface in one local loop.</h2>
        <p>
          Start with the SQLite-backed service mode. It discovers every list/watch-capable Kubernetes resource allowed by
          the current kubeconfig, keeps sanitized evidence locally, exposes read-only API checks, and gives agents the
          embedded Web UI plus a Streamable HTTP MCP surface.
        </p>
        <div class="quick-links">
          <a class="button button-primary" href="/docs/kube-insight/getting-started/">
            <Icon name="book-open" class="icon-sm" />
            Full quickstart
          </a>
          <a class="button button-secondary" href="/docs/kube-insight/guides/agent-sql-workflows/">
            <Icon name="workflow" class="icon-sm" />
            Agent workflow
          </a>
        </div>
      </div>
      <div class="quickstart-steps">
        <article>
          <span>01</span>
          <h3>Install the binary</h3>
          <p>Download a release artifact and keep the binary in the working directory for the local run.</p>
          <pre><code>{installCommand}</code></pre>
        </article>
        <article>
          <span>02</span>
          <h3>Start service mode</h3>
          <p>Run collection, storage, the embedded Web UI, HTTP API, and the Streamable HTTP MCP service together. Leaving resources unspecified uses discovery for the resources the collector can list/watch.</p>
          <pre><code>{serviceCommand}</code></pre>
        </article>
        <article>
          <span>03</span>
          <h3>Verify API and coverage</h3>
          <p>Check service health, inspect the active schema, then look for collection errors before trusting an investigation result.</p>
          <pre><code>{apiSmokeCommand}</code></pre>
        </article>
        <article>
          <span>04</span>
          <h3>Connect an agent through Streamable HTTP MCP</h3>
          <p>Point the agent at the long-running <code>/mcp</code> service endpoint instead of opening the database from a new stdio process. Keep <code>serve mcp</code> only as a fallback for runtimes that do not support remote MCP.</p>
          <pre><code>{mcpAgentConfig}</code></pre>
        </article>
      </div>
    </div>
  </section>

  <section class="section docs-map-section">
    <div class="page-shell docs-map-layout">
      <div class="section-intro">
        <p class="section-label">Docs map</p>
        <h2>The useful repo docs are now first-class website pages.</h2>
        <p>
          kube-insight's project repository now separates user, operator, and contributor docs. The website keeps the public paths task-oriented: agent setup, investigation cases, configuration, evidence vocabulary, and security boundaries are reachable without reading the repository tree.
        </p>
      </div>
      <div class="docs-highlight-grid">
        {docsHighlights.map((item) => (
          <a class="docs-highlight" href={item.href}>
            <span>{item.label}</span>
            <strong>{item.title}</strong>
            <p>{item.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section white-section">
    <div class="page-shell attraction-layout">
      <div class="section-intro sticky-copy">
        <p class="section-label">Why it matters</p>
        <h2>Current state is useful. It is not the whole story.</h2>
        <p>
          <code>kubectl</code> is still the live-state baseline, but many incidents are already gone by the time someone investigates: Events expire, rollouts are reverted, RBAC edits are fixed, EndpointSlices move, and Pods are replaced. kube-insight keeps the missing Kubernetes evidence and shapes it into fast, scoped investigation paths.
        </p>
        <div class="why-contrast" aria-label="kube-insight investigation contrast">
          <div><span>without history</span><strong>current objects only</strong></div>
          <div><span>with kube-insight</span><strong>versions, facts, edges, observations</strong></div>
        </div>
      </div>
      <div class="product-card-grid">
        {
          productCards.map((card) => (
            <article class="product-card">
              <Icon name={card.icon} class="icon-sm" />
              <h3>{card.title}</h3>
              <p>{card.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section performance-section">
    <div class="page-shell performance-layout">
      <div class="section-intro">
        <p class="section-label">Performance</p>
        <h2>Measured as investigation workflows, not isolated database tricks.</h2>
        <p>
          The validation compares retained evidence against broad live <code>kubectl</code> paths, then separates SQLite,
          ClickHouse, and chDB tradeoffs. The product claim is focused: pre-extracted evidence makes AIOps workflows
          faster and more repeatable before the final live-state check.
        </p>
      </div>
      <KubeInsightPerformance />
    </div>
  </section>

  <section class="section white-section">
    <div class="page-shell">
      <KubeInsightUseCases />
    </div>
  </section>

  <section class="section architecture-section">
    <div class="page-shell architecture-layout">
      <div class="section-intro">
        <p class="section-label">Architecture</p>
        <h2>Facts and edges are the candidate path. Versions are the proof.</h2>
        <p>
          Kubernetes data is captured once, filtered before storage, extracted into investigation tables, then served
          through narrow read surfaces: CLI, HTTP API, read-only SQL, MCP tools, and agent prompts.
        </p>
      </div>

      <KubeInsightFlow />
    </div>
  </section>


  <section class="section modes-section">
    <div class="page-shell">
      <div class="section-intro compact">
        <p class="section-label">Storage modes</p>
        <h2>Start local. Keep history central when the team needs it.</h2>
      </div>
      <div class="mode-table">
        {modes.map((mode) => (
          <article>
            <div class="mode-head">
              <StorageLogo name={mode.logo} size="lg" />
              <div>
                <span>{mode.role}</span>
                <strong>{mode.stat}</strong>
              </div>
            </div>
            <h3>{mode.name}</h3>
            <p>{mode.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section white-section">
    <div class="page-shell">
      <div class="soft-panel quickstart">
        <div>
          <p class="section-label">Next steps</p>
          <h2>Use the docs site when you are ready for the full path.</h2>
          <p>
            Installation, MCP usage, SQL recipes, security, retention, and storage-mode tradeoffs are rendered in the docs site from the project repository source.
          </p>
        </div>
        <div class="quick-actions">
          <a class="button button-primary" href="https://github.com/nowakeai/kube-insight">
            <Icon name="github" class="icon-sm" />
            Open GitHub
          </a>
          <a class="button button-secondary" href="/docs/kube-insight/">
            <Icon name="book-open" class="icon-sm" />
            Read Docs
          </a>
          <a class="button button-secondary" href="/docs/kube-insight/getting-started/">
            <Icon name="arrow-up-right" class="icon-sm" />
            Quickstart
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ki-product-hero {
    border-bottom: 1px solid var(--color-border);
  }

  .hero-layout {
    display: grid;
    gap: 2.5rem;
    padding-block: 4.75rem 3.5rem;
  }

  .hero-copy {
    align-self: center;
  }

  .ki-product-hero h1 {
    margin: 1.2rem 0 0;
    font-size: 3rem;
    line-height: 1;
    font-weight: 650;
  }

  .hero-tagline {
    max-width: 48rem;
    margin: 1rem 0 0;
    font-size: 1.5rem;
    font-weight: 650;
    line-height: 1.25;
  }

  .hero-description {
    max-width: 50rem;
    margin: 1.25rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .hero-description code,
  .performance-section code {
    color: var(--color-text);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.92em;
  }

  .hero-actions,
  .quick-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-console {
    align-self: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-surface-soft) 100%);
    box-shadow: var(--shadow-surface);
    padding: 1.2rem;
  }

  .console-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.9rem;
    color: var(--color-text-muted);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.72rem;
    font-weight: 650;
    text-transform: uppercase;
  }

  .console-header span:last-child {
    color: var(--color-accent);
  }

  .agent-sequence {
    position: relative;
    display: grid;
    gap: 0.7rem;
    margin-top: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-page);
    padding: 0.9rem;
    overflow: hidden;
  }

  .agent-sequence::before {
    content: "";
    position: absolute;
    inset: 3.15rem 0.9rem 1rem;
    background-image: linear-gradient(to right, var(--color-border) 1px, transparent 1px);
    background-size: 33.333% 100%;
    opacity: 0.75;
    pointer-events: none;
  }

  .participants {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.45rem;
  }

  .participants span {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-accent);
    padding: 0.45rem 0.3rem;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.65rem;
    font-weight: 650;
    text-align: center;
    text-transform: uppercase;
  }

  .sequence-row {
    --from: 0;
    --to: 1;
    position: relative;
    z-index: 1;
    min-height: 2.15rem;
  }

  .sequence-row::before {
    content: "";
    position: absolute;
    top: 50%;
    left: calc((100% - 0.45rem) * var(--from) / 3 + 0.225rem);
    width: calc((100% - 0.45rem) * (var(--to) - var(--from)) / 3);
    border-top: 1px solid var(--color-border-strong);
  }

  .sequence-row::after {
    content: "";
    position: absolute;
    top: calc(50% - 0.24rem);
    left: calc((100% - 0.45rem) * var(--to) / 3 - 0.25rem);
    width: 0.48rem;
    height: 0.48rem;
    border-right: 1px solid var(--color-border-strong);
    border-bottom: 1px solid var(--color-border-strong);
    transform: rotate(-45deg);
  }

  .sequence-row span {
    position: absolute;
    top: 0;
    left: calc((100% - 0.45rem) * var(--from) / 3 + 0.6rem);
    max-width: 58%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    padding: 0.35rem 0.5rem;
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 0.68rem;
    font-weight: 650;
    line-height: 1.25;
  }

  .agent-to-mcp { --from: 0; --to: 1; }
  .mcp-to-db { --from: 1; --to: 2; }
  .db-to-agent { --from: 0; --to: 2; }
  .agent-to-db { --from: 0; --to: 2; }
  .agent-to-kube { --from: 0; --to: 3; }

  .db-to-agent::after {
    left: calc((100% - 0.45rem) * var(--from) / 3 + 0.02rem);
    transform: rotate(135deg);
  }

  .db-to-agent span {
    left: calc((100% - 0.45rem) * var(--from) / 3 + 0.6rem);
    background: var(--color-accent-soft);
  }

  .proof-row span {
    background: var(--color-signal-soft);
  }

  .optional-row span {
    border-style: dashed;
    background: var(--color-page);
    color: var(--color-text-muted);
  }

  .metrics-band {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .metrics-grid {
    display: grid;
    gap: 0;
  }

  .metrics-grid article {
    border-bottom: 1px solid var(--color-border);
    padding: 1.25rem 0;
  }

  .metrics-grid strong {
    display: block;
    color: var(--color-accent);
    font-family: "IBM Plex Mono", ui-monospace, monospace;
    font-size: 1.05rem;
  }

  .metrics-grid span {
    display: block;
    max-width: 18rem;
    margin-top: 0.4rem;
    color: var(--color-text-muted);
    font-size: 0.86rem;
    line-height: 1.45;
  }

  .section {
    border-top: 1px solid var(--color-border);
    padding-block: 4rem;
  }

  .release-strip {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-soft);
    padding-block: 2.5rem;
  }

  .release-layout {
    display: grid;
    gap: 1.5rem;
  }

  .release-summary h2 {
    margin: 0.55rem 0 0;
    font-size: 1.65rem;
    line-height: 1.18;
  }

  .release-summary p:not(.section-label) {
