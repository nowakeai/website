  wrench: '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.4 2.4-2-2.4z"/>',
};

const path = paths[name] ?? paths["box"];
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill={name === "github" ? "currentColor" : "none"}
  stroke={name === "github" ? "none" : "currentColor"}
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={path}
/>
