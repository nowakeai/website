---
const { name, size = "md" } = Astro.props;
const normalized = String(name || "").toLowerCase();
const icons = {
  sqlite: {
    label: "SQLite",
    src: "https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/sqlite.svg",
  },
  clickhouse: {
    label: "ClickHouse",
    src: "https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/clickhouse.svg",
  },
  chdb: {
    label: "chDB",
    src: "/assets/logos/chdb.png",
  },
};
const icon = icons[normalized];
---

<span class:list={["storage-logo", `storage-logo-${size}`, normalized === "chdb" && "storage-logo-chdb"]} aria-hidden="true">
  {icon ? <img src={icon.src} alt="" loading="lazy" decoding="async" /> : null}
</span>

<style>
  .storage-logo {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    box-shadow: 0 10px 30px rgba(29, 53, 93, 0.06);
  }

  .storage-logo-md {
    width: 2.4rem;
    height: 2.4rem;
  }

  .storage-logo-lg {
    width: 3rem;
    height: 3rem;
  }

  .storage-logo img {
    width: 64%;
    height: 64%;
    object-fit: contain;
    opacity: 0.86;
  }

  .storage-logo-chdb {
    background: var(--color-surface);
  }

  .storage-logo-chdb img {
    width: 92%;
    height: 92%;
    border-radius: 0.25rem;
    opacity: 1;
  }
</style>
